# ==============================================
# Stock Finder — 환경변수 템플릿 (전부 선택사항)
#
# 필요하면 이 파일을 server/.env 로 복사해서 쓰세요.
# 아무것도 설정하지 않아도 로컬 파일 DB(PGlite)로 바로 동작합니다.
# ⚠️ server/.env 는 gitignore 대상입니다 — 실제 키를 여기(.env.example)에 적지 마세요.
# ==============================================

# ── 서버 ─────────────────────────────────────
# 서버 포트 (기본 4000)
# PORT=4000

# CORS 허용 오리진 (콤마 구분, 기본 http://localhost:5173)
# ALLOWED_ORIGINS=http://localhost:5173

# 접속 비밀번호 (선택) — 설정하면 앱 전체에 Basic Auth 한 겹이 걸립니다.
# 신뢰할 수 없는 네트워크(공개 인터넷·터널링 등)에 노출한다면 반드시 설정하세요.
# 아이디는 아무거나 넣어도 되고 비밀번호만 비교합니다.
# ACCESS_PASSWORD=change-me

# ── DB ───────────────────────────────────────
# 관리형 PostgreSQL 연결 문자열 (Neon/Supabase/Railway 등).
# 설정하면 로컬 파일 DB(PGlite) 대신 해당 DB를 사용합니다. 클라우드 배포 시에만 필요.
# DATABASE_URL=postgresql://user:password@host/dbname

# ── 외부 API 키 (선택) ────────────────────────
# 미설정이면 해당 기능만 건너뛰고 나머지는 정상 동작합니다.

# DART OpenAPI — 공시 수집·이벤트 룰, 분기 실적 이력 백필
# 발급: https://opendart.fss.or.kr
# DART_API_KEY=

# KRX 정보데이터시스템 로그인 — 투자자별 순매수대금 세부 8주체 공식 금액
# 미설정 시 네이버 근사치만 사용합니다.
# KRX_ID=
# KRX_PW=

# 한국투자증권 OpenAPI — 국내 일봉(수정주가 정본)·신용잔고·야간선물
# 미설정 시 Yahoo Finance 일봉으로 폴백합니다.
# 발급: https://apiportal.koreainvestment.com
# KIS_APP_KEY=
# KIS_APP_SECRET=

# ── 스케줄 (크론 표현식, KST 기준) ─────────────
# 미설정이면 해당 스케줄은 비활성입니다.

# 전체 수집 — 평일 18:10.
# 네이버 투자자별 수급이 저녁에 확정되므로 장 마감보다 늦게 잡습니다.
# CRON_REFRESH=10 18 * * 1-5
# CRON_REFRESH_SCOPE=all

# 마감 직후 시세·지표·점수만 선반영 (scope=prices 고정 — 수급·재무·공시는 걷지 않음)
# CRON_REFRESH_EARLY=50 15 * * 1-5

# 전체 수집 누락 점검 — 스케줄러는 인프로세스 타이머라 프로세스가 꺼져 있으면
# 그 슬롯을 건너뜁니다. 저녁에 매시 점검해 소급 실행합니다.
# CRON_REFRESH_CATCHUP=5 19-23 * * 1-5

# 마감 직후 KRX 수급만 수집 (미발표 시 30분 간격 최대 6회 재시도)
# CRON_FLOWS=50 15 * * 1-5

# DART 공시 폴링 — 새 공시가 있는 종목만 재채점 (DART는 푸시가 없어 폴링으로 근사)
# CRON_DISCLOSURES=*/20 8-20 * * 1-5

# 시장 색깔만 재계산 (수집 없이 가벼움)
# CRON_REGIME=40 8 * * 1-5

# ETF 전종목 일별 스냅샷 (자금유입 추정·RS 순위·국면 이력용)
# CRON_ETF_SNAPSHOT=50 15 * * 1-5

# 네이버 테마 일별 등락률 스냅샷 (로테이션·연속상승 감지용)
# CRON_THEME_SNAPSHOT=50 15 * * 1-5
